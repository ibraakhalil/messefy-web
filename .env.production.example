# ==============================================================
# MESSEFY PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to ~/messefy-web/.env on your server (80.225.215.51)
# ==============================================================

# Database Credentials
POSTGRES_DB=messefydb
POSTGRES_USER=messefy
POSTGRES_PASSWORD=your_super_strong_postgres_password_here

# Exposed Ports
BACKEND_PORT=5555
FRONTEND_PORT=3333

# Backend Environment
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://80.225.215.51:3333

# Frontend Environment & NextAuth
AUTH_SECRET=your_auth_secret_here
AUTH_GOOGLE_ID=your_google_client_id_if_used
AUTH_GOOGLE_SECRET=your_google_client_secret_if_used

# Client-side API URL (Browser will use this to call Backend)
NEXT_PUBLIC_API_URL=http://80.225.215.51:5555
